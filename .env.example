# =============================================================================
# OpenCode Remote Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked "Required" must be set before the server starts.
# Variables marked "Optional" can be left commented out to use defaults.
# =============================================================================

# --- Required ---

# OpenCode version to build (Docker image tag source of truth).
OPENCODE_VERSION=2.2.7

# --- Optional: toolchain version pins ---

# Every tool below defaults to a known-good version baked into the Dockerfile,
# so you can leave this whole section commented and the image still builds.
# Uncomment any line to bump (or downgrade) that tool without editing the
# Dockerfile; redeploy to rebuild with the new version. A bad pin fails the
# build loudly via the image smoke test instead of shipping.
# PNPM_VERSION=11.9.0
# YARN_VERSION=4.17.0
# RTK_VERSION=v1.2.0
# CODEGRAPH_VERSION=1.6.2
# TOKSCALE_VERSION=4.21.0
# WAKATIME_VERSION=1.4.0

# Password to protect the OpenCode web UI and API (v2 canonical name).
# The HTTP basic-auth username is always `opencode` in v2.
# Set this to a strong, unique password.
OPENCODE_PASSWORD=changeme

# API key for the OpenCode Go provider (the model you want agents to use).
# Without this, OpenCode has no model provider to talk to.
# Get your key from your Go API provider's dashboard.
OPENCODE_GO_API_KEY=

# API key for the OpenCode Zen provider (alternative to Go provider).
# Falls back to OPENCODE_GO_API_KEY if not set. Can use the same key.
# OPENCODE_ZEN_API_KEY=

# --- Optional: Authentication ---

# No username variable: v2 removed OPENCODE_SERVER_USERNAME.
# (Do not set it; the username is always `opencode`.)

# --- Optional: SSH Deploy Key (for git push/pull by agents) ---

# The full private key contents for an SSH deploy key.
# Agents use this key to push code to and pull code from GitHub/GitLab.
# Generate a key with:
#   ssh-keygen -t ed25519 -C "opencode@server" -f ~/.ssh/opencode_deploy_key
# Then paste the contents of the private key file here (multi-line is fine).
# SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
# somebase64data
# morebase64data
# -----END OPENSSH PRIVATE KEY-----

# Git user.name for commits made by agents.
# GIT_USER_NAME=OpenCode Agent

# Git user.email for commits made by agents.
# GIT_USER_EMAIL=agent@opencode.example.com

# GitHub CLI authentication token.
# Allows agents to use gh CLI (create PRs, issues, releases, etc.) without
# interactive login. Generate at: GitHub → Settings → Developer settings → Personal access tokens
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# --- Optional: WakaTime ---

# WakaTime API key for coding activity tracking (used by the pre-installed
# opencode-wakatime plugin). Get yours at: https://wakatime.com/settings/api-key
# WAKATIME_API_KEY=
