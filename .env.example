# =============================================================================
# OpenCode Remote Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked "Required" must be set before the server starts.
# Variables marked "Optional" can be left commented out to use defaults.
# =============================================================================

# --- Required ---

# Password to protect the OpenCode web UI and API.
# Set this to a strong, unique password.
OPENCODE_SERVER_PASSWORD=changeme

# API key for the OpenCode Go provider (the model you want agents to use).
# Without this, OpenCode has no model provider to talk to.
# Get your key from your Go API provider's dashboard.
OPENCODE_GO_API_KEY=

# --- Optional: Authentication ---

# Username for HTTP basic auth.
# Defaults to "opencode" if not set.
# OPENCODE_SERVER_USERNAME=opencode

# --- Optional: SSH Deploy Key (for git push/pull by agents) ---

# The full private key contents for an SSH deploy key.
# Newlines must be written as literal \n (backslash-n), not actual line breaks.
# Agents use this key to push code to and pull code from GitHub/GitLab.
# Generate a key with:
#   ssh-keygen -t ed25519 -C "opencode@server" -f ~/.ssh/opencode_deploy_key
# Then paste the contents of the private key file here, replacing newlines with \n.
# SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\nsomebase64data\nmorebase64data\n-----END OPENSSH PRIVATE KEY-----

# Git user.name for commits made by agents.
# GIT_USER_NAME=OpenCode Agent

# Git user.email for commits made by agents.
# GIT_USER_EMAIL=agent@opencode.example.com
